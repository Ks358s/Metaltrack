# Copy this file to .env (in the project root or in DrPost/) and fill it in. Never commit .env.

# ---- Mail account ----
# Gmail needs an App Password: Google Account > Security > 2-Step Verification > App passwords.
SENDER_EMAIL=your.account@gmail.com
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Dr. Post
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# true = log mails instead of sending them (good for demos and tests).
# In dry-run, addresses ending in @fail.test fail on purpose to show retries.
DRY_RUN=false

# ---- First admin account (created on first start only) ----
# If ADMIN_PASSWORD is empty, a random password is printed in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Limits ----
DAILY_LIMIT=450          # Gmail allows about 500 mails per 24 hours
PER_MINUTE_LIMIT=20
MAX_ATTEMPTS=3           # tries per address before it is marked failed
MAX_RECIPIENTS=500       # per send
MAX_ATTACHMENT_MB=10

# ---- Server ----
HOST=127.0.0.1
PORT=6767
# Other browser front ends allowed to call the API, comma separated
ALLOWED_ORIGINS=
# Where the SQLite database and attachments are kept (default: DrPost/data)
# DB_PATH=
# ATTACHMENT_DIR=
